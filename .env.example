# ==============================================================================
# STGAT-MARL Environment Configuration Template
# Copy this file to .env and adjust values as needed.
# ==============================================================================

# Server Network Configuration
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8000
LOG_LEVEL=INFO

# Machine Learning Checkpoints
STGAT_CHECKPOINT=checkpoints/best_stgat.pt
MAPPO_CHECKPOINT=checkpoints/mappo_latest.pt

# Multi-Agent Swarm Configuration
NUM_DEVELOPER_AGENTS=3
WORKSPACE_BASE_PORT=24000
WORKTREE_BASE_DIR=.worktrees

# Memory & PromptQL Configuration
VECTOR_STORE_DIM=64
VECTOR_STORE_FILE=data/vector_store.json
MAX_RAG_CHUNKS=5

# Optional LLM API Provider Keys (for live LLM-assisted agent code generation)
# Leave blank to use deterministic rule-based / conservative AST code generation
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
